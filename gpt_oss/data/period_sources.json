  "passages": [
    {
      "id": "yan-fidelity",
      "source": "yan-1898",
      "locator": "第一則",
      "text": "譯事三難：信、達、雅。求其信已大難矣，顧信矣不達，雖譯猶不譯也，則達尚焉。",
      "sha256": "d785fdff02ef770000e7768c407b96721ae84c0e6fe2b2c5174013b58b8ad611",
      "aliases": [
        "譯事三難",
        "信達雅",
        "嚴復",
        "天演論",
        "yan fu"
      ],
      "split": "train"
    },
    {
      "id": "yan-syntax",
      "source": "yan-1898",
      "locator": "第二則",
      "text": "至原文詞理本深，難於共喻，則當前後引襯，以顯其意。凡此經營，皆以為達，為達即所以為信也。",
      "sha256": "59c214b613f1c9222e5f5b3c052329416cd703fe9432207b5a7bdde70f2f6a2f",
      "aliases": [
        "前後引襯",
        "為達即所以為信",
        "西文句法"
      ],
      "split": "train"
    },
    {
      "id": "yan-inquiry",
      "source": "yan-1898",
      "locator": "第六則",
      "text": "窮理與從政相同，皆貴集思廣益。今遇原文所論，與他書有異同者，輒就譾陋所知，列入後案，以資參考。",
      "sha256": "be78dabaa9fb20990597c5d14a929a9896bbf30cbcdacd76eb57ef524eba3b3c",
      "aliases": [
        "集思廣益",
        "窮理",
        "後案"
      ],
      "split": "train"
    },
    {
      "id": "liang-change",
      "source": "liang-1896",
      "locator": "首段",
      "text": "故夫變者，古今之公理也：貢助之法變為租庸調，租庸調變為兩稅，兩稅變為一條鞭。",
      "sha256": "3df483938e167cd460e58d8e6183160907f534f4796dd0cecbc08707e3542a37",
      "aliases": [
        "變法通議",
        "梁啟超",
        "古今之公理",
        "liang qichao",
        "一條鞭"
      ],
      "split": "train"
    },
    {
      "id": "ma-characters",
      "source": "ma-1898",
      "locator": "論文字形聲",
      "text": "殊不知古先造字，點畫音韵，千變萬化，其賦以形而命以聲者，原無不變之理。",
      "sha256": "a124a7ad7f9a394b14955ecf3047fee07c20fa6c42d0df6c5793b1c64ad7c456",
      "aliases": [
        "馬氏文通",
        "馬建忠",
        "點畫音韵",
        "形聲",
        "ma jianzhong"
      ],
      "split": "eval"
    },
    {
      "id": "lovelace-weaving",
      "source": "lovelace-1843",
      "locator": "paragraph on Jacquard cards",
      "text": "We may say most aptly, that the Analytical Engine weaves algebraical patterns just as the Jacquard-loom weaves flowers and leaves.",
      "sha256": "27bfca7255afd0e64c8273a0ba7fe85cf8c95986090a5fc16e2d89ce52dc2342",
      "aliases": [
        "lovelace",
        "analytical engine",
        "jacquard",
        "分析機",
        "洛夫萊斯"
      ],
      "split": "train"
    },
    {
      "id": "carroll-attributes",
      "source": "carroll-1896",
      "locator": "opening example",
      "text": "The Universe contains ‘Things.’",
