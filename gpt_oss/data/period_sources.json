    {
      "id": "huxley-ethics",
      "source": "huxley-1893",
      "locator": "paragraph beginning ‘Let us understand’",
      "text": "Let us understand, once for all, that the ethical progress of society depends, not on imitating the cosmic process, still less in running away from it, but in combating it.",
      "sha256": "4c622627f81a3b3da44528f3a889fb06ca61a077d226f4e331e7bfabd3c96183",
      "aliases": [
        "evolution and ethics",
        "cosmic process",
        "huxley",
        "赫胥黎"
      ],
      "split": "eval"
    },
    {
      "id": "yan-names",
      "source": "yan-1898",
      "locator": "第四則",
      "text": "新理踵出，名目紛繁，索之中文，渺不可得，即有牽合，終嫌參差，譯者遇此，獨有自具衡量，即義定名。",
      "aliases": [
        "即義定名",
        "名目紛繁",
        "新理踵出"
      ],
      "split": "train",
      "sha256": "cf74a4438d229c790bc0194f2c7685ac7101d8e98f1138caa997b63ae098fa03"
    },
    {
      "id": "yan-opinion",
      "source": "yan-1898",
      "locator": "第六則末",
      "text": "是非然否，以俟公論，不敢固也。",
      "aliases": [
        "以俟公論",
        "不敢固也"
      ],
      "split": "train",
      "sha256": "4e81a178d5f96a2e47b0ca816ce0701fe7b6b9dfdc98ac97e93b4a09a3ad5738"
    },
    {
      "id": "liang-reform",
      "source": "liang-1896",
      "locator": "首段後半",
      "text": "上下千歲，無時不變，無事不變，公理有固然，非夫人之為也。",
      "aliases": [
        "上下千歲",
        "無時不變",
        "無事不變"
      ],
      "split": "train",
      "sha256": "1ec154659d33fb64b9e041a15053d88fbe1dbbb43ff8c7c5b97d6d35e6f5935a"
    },
    {
      "id": "carroll-rose",
      "source": "carroll-1896",
      "locator": "example on attributes",
      "text": "Thus, the Thing “a rose” may have the Attributes “red,” “scented,” “full-blown,” &c.",
      "aliases": [
        "rose example",
